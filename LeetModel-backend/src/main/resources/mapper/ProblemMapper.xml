<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.senior.leetmodelbackend.mapper.ProblemMapper">

    <select id="getProblemsByQueryDTO" resultType="com.senior.leetmodelbackend.entity.pojo.Problem">
        SELECT * FROM problem
        <where>
            <if test="difficulty != null and difficulty != ''">
                AND difficulty = #{difficulty}
            </if>
            <if test="language != null and language != ''">
                AND language = #{language}
            </if>
            <if test="keyword != null and keyword != ''">
                AND (title LIKE CONCAT('%', #{keyword}, '%') OR content LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="minAveScore != null">
                AND ave_score >= #{minAveScore}
            </if>
            <if test="maxAveScore != null">
                AND ave_score &lt;= #{maxAveScore}
            </if>
        </where>
        <if test="sortOrder != null and sortOrder != ''">
            ORDER BY id ${sortOrder}
        </if>
    </select>

</mapper>