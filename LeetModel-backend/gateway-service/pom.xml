<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.leetmodel</groupId>
        <artifactId>LeetModel-backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>gateway-service</artifactId>
    <name>gateway-service</name>
    <description>API 网关 —— 统一入口、路由转发、鉴权拦截、跨域处理</description>

    <!--
    ⚠️ Gateway 是独立部署的 Spring Boot 应用，不是公共 jar 模块。
    公共 jar 模块（common-core 等）需要 <description> 中注明 "skip" 以跳过打包，
    Gateway 不需要 —— 默认会启用 spring-boot-maven-plugin 打包为可执行 jar。
    -->

    <dependencies>
        <!-- Spring Cloud Gateway 核心（基于 Netty + WebFlux，非阻塞 I/O） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
        </dependency>

        <!-- 负载均衡：从 Nacos 拿到多实例时自动选一个 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- Nacos 服务发现：Gateway 从 Nacos 拉取服务列表 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!--
        Sa-Token 响应式版（⚠️ 不能用 servlet 版！）
        Gateway 基于 WebFlux，必须用 reactor 变体，否则启动报错。
        -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-reactor-spring-boot3-starter</artifactId>
        </dependency>

        <!-- JWT 无状态认证（校验签名 + 过期时间，不查 Redis Session） -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-jwt</artifactId>
        </dependency>

        <!-- Knife4j Gateway 聚合：在网关层统一展示所有微服务的 API 文档 -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-gateway-spring-boot-starter</artifactId>
        </dependency>

        <!-- Redis 响应式客户端：JWT Token 黑名单校验（登出 Token 拒绝） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>

        <!-- Nacos 配置中心：动态配置刷新（JWT 密钥、路由规则等） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- Actuator 健康检查：K8s 探活/就绪探针 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 公共模块：仅复用 Result 响应体，排除 MVC 和数据库依赖 -->
        <dependency>
            <groupId>com.leetmodel</groupId>
            <artifactId>common-core</artifactId>
            <exclusions>
                <!-- Gateway 基于 WebFlux，不能引入 Spring MVC -->
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-web</artifactId>
                </exclusion>
                <!-- Gateway 不连数据库，排除 MyBatis-Plus 及其传递的 JDBC -->
                <exclusion>
                    <groupId>com.baomidou</groupId>
                    <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 打包为可执行 jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
