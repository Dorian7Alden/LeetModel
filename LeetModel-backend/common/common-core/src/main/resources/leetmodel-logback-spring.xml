<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="false">
    <springProperty scope="context" name="SERVICE_NAME"
                    source="spring.application.name" defaultValue="unknown-service"/>
    <springProperty scope="context" name="ENVIRONMENT"
                    source="spring.profiles.active" defaultValue="default"/>

    <property name="SERVICE_VERSION" value="${SERVICE_VERSION:-0.0.1-SNAPSHOT}"/>
    <property name="SERVICE_INSTANCE" value="${SERVICE_INSTANCE:-}"/>
    <property name="LOG_DIR" value="${LEETMODEL_LOG_DIR:-logs}"/>
    <property name="LOG_MAX_FILE_SIZE" value="${LEETMODEL_LOG_MAX_FILE_SIZE:-100MB}"/>
    <property name="LOG_MAX_HISTORY" value="${LEETMODEL_LOG_MAX_HISTORY:-7}"/>
    <property name="LOG_TOTAL_SIZE_CAP" value="${LEETMODEL_LOG_TOTAL_SIZE_CAP:-1GB}"/>
    <springProperty scope="context" name="SKYWALKING_LOG_ENABLED"
                    source="leetmodel.logging.reporter.enabled" defaultValue="false"/>
    <springProperty scope="context" name="SKYWALKING_LOG_ENDPOINT"
                    source="leetmodel.logging.reporter.endpoint"
                    defaultValue="http://127.0.0.1:12800/v3/logs"/>
    <springProperty scope="context" name="SKYWALKING_LOG_QUEUE_CAPACITY"
                    source="leetmodel.logging.reporter.queue-capacity" defaultValue="2048"/>
    <springProperty scope="context" name="SKYWALKING_LOG_BATCH_SIZE"
                    source="leetmodel.logging.reporter.batch-size" defaultValue="64"/>
    <springProperty scope="context" name="SKYWALKING_LOG_FLUSH_MS"
                    source="leetmodel.logging.reporter.flush-interval-millis" defaultValue="500"/>
    <springProperty scope="context" name="SKYWALKING_LOG_CONNECT_TIMEOUT_MS"
                    source="leetmodel.logging.reporter.connect-timeout-millis" defaultValue="500"/>
    <springProperty scope="context" name="SKYWALKING_LOG_REQUEST_TIMEOUT_MS"
                    source="leetmodel.logging.reporter.request-timeout-millis" defaultValue="1500"/>
    <springProperty scope="context" name="SKYWALKING_LOG_MAX_ATTEMPTS"
                    source="leetmodel.logging.reporter.max-attempts" defaultValue="2"/>
    <springProperty scope="context" name="SKYWALKING_LOG_RETRY_BACKOFF_MS"
                    source="leetmodel.logging.reporter.retry-backoff-millis" defaultValue="100"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <charset>UTF-8</charset>
            <layout class="com.leetmodel.common.core.logging.LeetModelJsonLayout">
                <service>${SERVICE_NAME}</service>
                <environment>${ENVIRONMENT}</environment>
                <serviceVersion>${SERVICE_VERSION}</serviceVersion>
                <instance>${SERVICE_INSTANCE}</instance>
            </layout>
        </encoder>
    </appender>

    <appender name="SKYWALKING_REPORTER"
              class="com.leetmodel.common.core.logging.SkyWalkingLogReporterAppender">
        <enabled>${SKYWALKING_LOG_ENABLED}</enabled>
        <endpoint>${SKYWALKING_LOG_ENDPOINT}</endpoint>
        <service>${SERVICE_NAME}</service>
        <instance>${SERVICE_INSTANCE}</instance>
        <queueCapacity>${SKYWALKING_LOG_QUEUE_CAPACITY}</queueCapacity>
        <batchSize>${SKYWALKING_LOG_BATCH_SIZE}</batchSize>
        <flushIntervalMillis>${SKYWALKING_LOG_FLUSH_MS}</flushIntervalMillis>
        <connectTimeoutMillis>${SKYWALKING_LOG_CONNECT_TIMEOUT_MS}</connectTimeoutMillis>
        <requestTimeoutMillis>${SKYWALKING_LOG_REQUEST_TIMEOUT_MS}</requestTimeoutMillis>
        <maxAttempts>${SKYWALKING_LOG_MAX_ATTEMPTS}</maxAttempts>
        <retryBackoffMillis>${SKYWALKING_LOG_RETRY_BACKOFF_MS}</retryBackoffMillis>
        <layout class="com.leetmodel.common.core.logging.LeetModelJsonLayout">
            <service>${SERVICE_NAME}</service>
            <environment>${ENVIRONMENT}</environment>
            <serviceVersion>${SERVICE_VERSION}</serviceVersion>
            <instance>${SERVICE_INSTANCE}</instance>
        </layout>
    </appender>

    <appender name="LOCAL_ROLLING" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${SERVICE_NAME}.json.log</file>
        <append>true</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archive/${SERVICE_NAME}.%d{yyyy-MM-dd}.%i.json.gz</fileNamePattern>
            <maxFileSize>${LOG_MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${LOG_MAX_HISTORY}</maxHistory>
            <totalSizeCap>${LOG_TOTAL_SIZE_CAP}</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <charset>UTF-8</charset>
            <layout class="com.leetmodel.common.core.logging.LeetModelJsonLayout">
                <service>${SERVICE_NAME}</service>
                <environment>${ENVIRONMENT}</environment>
                <serviceVersion>${SERVICE_VERSION}</serviceVersion>
                <instance>${SERVICE_INSTANCE}</instance>
            </layout>
        </encoder>
    </appender>

    <logger name="org.apache.ibatis" level="INFO"/>
    <logger name="com.baomidou.mybatisplus" level="INFO"/>
    <logger name="org.springframework.jdbc.core" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="LOCAL_ROLLING"/>
        <appender-ref ref="SKYWALKING_REPORTER"/>
    </root>
</configuration>
