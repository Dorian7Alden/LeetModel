{
  "annotations": {"list": []},
  "description": "LeetModel 服务可用性、HTTP RED、JVM、线程池与数据库连接池总览。",
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "leetmodel-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "leetmodel:service_up:count", "legendFormat": "UP", "refId": "A"}],
      "title": "可用服务数",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "leetmodel-prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{job=\"leetmodel-services\"}[5m]))", "legendFormat": "RPS", "refId": "A"}],
      "title": "HTTP 请求率",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "leetmodel-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{job=\"leetmodel-services\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"leetmodel-services\"}[5m])), 1e-9)", "legendFormat": "5xx", "refId": "A"}],
      "title": "HTTP 5xx 比例",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "leetmodel-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"leetmodel-services\"}[5m])))", "legendFormat": "P95", "refId": "A"}],
      "title": "HTTP P95",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "leetmodel-prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "id": 5,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (service) (rate(http_server_requests_seconds_count{job=\"leetmodel-services\"}[5m]))", "legendFormat": "{{service}}", "refId": "A"}],
      "title": "各服务请求率",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "leetmodel-prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "id": 6,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (service) (jvm_memory_used_bytes{job=\"leetmodel-services\",area=\"heap\"})", "legendFormat": "{{service}}", "refId": "A"}],
      "title": "JVM Heap 使用量",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "leetmodel-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "id": 7,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (service, name) (executor_active_threads{job=\"leetmodel-services\"})", "legendFormat": "{{service}} / {{name}}", "refId": "A"}],
      "title": "业务线程池活跃线程",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "leetmodel-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "id": 8,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (service, pool) (hikaricp_connections_active{job=\"leetmodel-services\"})", "legendFormat": "{{service}} / {{pool}}", "refId": "A"}],
      "title": "HikariCP 活跃连接",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["leetmodel", "system"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "LeetModel / 系统总览",
  "uid": "leetmodel-system-overview",
  "version": 1
}
