      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "leetmodel_review_tasks_oldest_waiting_seconds", "legendFormat": "review", "refId": "A"}, {"expr": "leetmodel_ranking_rebuild_oldest_waiting_seconds", "legendFormat": "ranking", "refId": "B"}],
