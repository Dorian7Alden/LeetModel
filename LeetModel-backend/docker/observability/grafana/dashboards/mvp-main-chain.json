      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (service) (rate(http_server_requests_seconds_count{job=\"leetmodel-services\",service=~\"gateway-service|user-service|team-service|problem-service|submission-service|ai-review-service|ranking-service\"}[5m]))", "legendFormat": "{{service}}", "refId": "A"}],
      "title": "主链请求率",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "leetmodel-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {"legend": {"calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (service) (rate(http_server_requests_seconds_count{job=\"leetmodel-services\",status=~\"5..\",service=~\"gateway-service|user-service|team-service|problem-service|submission-service|ai-review-service|ranking-service\"}[5m])) / clamp_min(sum by (service) (rate(http_server_requests_seconds_count{job=\"leetmodel-services\",service=~\"gateway-service|user-service|team-service|problem-service|submission-service|ai-review-service|ranking-service\"}[5m])), 1e-9)", "legendFormat": "{{service}}", "refId": "A"}],
      "title": "主链 5xx 比例",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "leetmodel-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 8},
      "id": 3,
      "options": {"legend": {"calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (service, uri, le) (rate(http_server_requests_seconds_bucket{job=\"leetmodel-services\",service=~\"gateway-service|user-service|team-service|problem-service|submission-service|ai-review-service|ranking-service\"}[5m])))", "legendFormat": "{{service}} {{uri}}", "refId": "A"}],
      "title": "主链路由模板 P95",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "leetmodel-prometheus"},
