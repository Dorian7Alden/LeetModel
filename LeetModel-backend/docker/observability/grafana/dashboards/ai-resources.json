      "id": 1,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "sum(leetmodel_ai_queue_tasks{state=\"queued\"})", "legendFormat": "queued", "refId": "A"}],
      "title": "排队任务",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "leetmodel-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "leetmodel_ai_queue_oldest_seconds{priority=\"p0\"}", "legendFormat": "P0", "refId": "A"}],
      "title": "P0 最老等待",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "leetmodel-prometheus"},
