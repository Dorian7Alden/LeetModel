<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.leetmodel</groupId>
        <artifactId>LeetModel-backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>common-security</artifactId>
    <packaging>jar</packaging>
    <description>LeetModel 公共安全模块：Sa-Token JWT 认证 + RBAC 鉴权</description>

    <dependencies>
        <!-- common-core：Result、BusinessException、ErrorCode -->
        <dependency>
            <groupId>com.leetmodel</groupId>
            <artifactId>common-core</artifactId>
        </dependency>

        <!-- common-api：UserFeignClient 查询角色权限 -->
        <dependency>
            <groupId>com.leetmodel</groupId>
            <artifactId>common-api</artifactId>
        </dependency>

        <!-- Spring Cloud LoadBalancer：StpInterfaceImpl 通过 Feign 调用 user 服务时解析服务名 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- Sa-Token：轻量权限框架 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
        </dependency>

        <!-- Sa-Token JWT 扩展：Token 无状态签发与验签 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-jwt</artifactId>
        </dependency>

        <!-- Redis：Token 黑名单存储 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Spring Security 底层（Sa-Token 与其整合） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
    </dependencies>

    <!-- 公共 jar 模块不启用 spring-boot-maven-plugin -->

</project>
